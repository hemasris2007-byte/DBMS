// MongoDB – Column Based Data
// Apache Cassandra

CREATE KEYSPACE CollegeDB
WITH replication = {
    'class': 'SimpleStrategy',
    'replication_factor': 1
};

USE CollegeDB;

CREATE TABLE Student (
    Student_ID int PRIMARY KEY,
    Name text,
    Department text,
    Marks int
);

INSERT INTO Student VALUES
(101, 'Arun', 'IT', 85);

INSERT INTO Student VALUES
(102, 'Bala', 'CSE', 78);

INSERT INTO Student VALUES
(103, 'Divya', 'IT', 92);

SELECT * FROM Student;


// MongoDB – Graph Based Data
// Neo4j Cypher

CREATE (s1:Student {id:101, name:'Arun', department:'IT'});
CREATE (s2:Student {id:102, name:'Bala', department:'CSE'});
CREATE (s3:Student {id:103, name:'Divya', department:'IT'});

CREATE (s1)-[:FRIEND]->(s2);
CREATE (s1)-[:FRIEND]->(s3);

MATCH (s:Student)
RETURN s;
