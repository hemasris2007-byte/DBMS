CREATE DATABASE JoinDB;
USE JoinDB;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(30),
    Department_ID INT,
    Marks INT
);

CREATE TABLE Department (
    Department_ID INT PRIMARY KEY,
    Department_Name VARCHAR(30)
);

