-- SIMPLE QUERIES
SELECT * FROM Student;

SELECT * FROM Student
WHERE Department = 'IT';

SELECT Name, Marks
FROM Student
WHERE Marks > 80;

-- NESTED QUERIES
SELECT Name, Marks
FROM Student
WHERE Marks > (SELECT AVG(Marks) FROM Student);

SELECT Name, Marks
FROM Student
WHERE Marks = (SELECT MAX(Marks) FROM Student);

SELECT Name, Department
FROM Student
WHERE Department = (
    SELECT Department
    FROM Student
    WHERE Name = 'Arun'
);

-- SUB QUERY USING IN
SELECT Name, Department
FROM Student
WHERE Department IN (
    SELECT Department
    FROM Student
    WHERE Marks > 90
);

-- SUB QUERY USING EXISTS
SELECT Name, Department
FROM Student S
WHERE EXISTS (
    SELECT *
    FROM Student
    WHERE Department = S.Department
    AND Marks > 90
);
